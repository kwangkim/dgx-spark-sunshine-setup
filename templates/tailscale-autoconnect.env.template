# /etc/default/tailscale-autoconnect
# Optional extra args for `tailscale up` (applied on every boot).
# Default preserves the machine's existing DNS instead of accepting tailnet DNS.
#
# After editing, reload and restart the service:
#   sudo systemctl daemon-reload
#   sudo systemctl restart tailscale-autoconnect
#
# Examples:
#   TS_UP_EXTRA_ARGS="--accept-dns=false --ssh"        # Preserve local DNS + enable Tailscale SSH
#   TS_UP_EXTRA_ARGS="--accept-dns=true"               # Opt into tailnet DNS / MagicDNS
#   TS_UP_EXTRA_ARGS="--accept-dns=false --advertise-exit-node"  # Act as exit node
#   TS_UP_EXTRA_ARGS="--accept-dns=false --ssh --accept-routes"  # Multiple flags
#
# Recommended default: keep local DNS unless you explicitly want tailnet DNS.
TS_UP_EXTRA_ARGS="--accept-dns=false"
