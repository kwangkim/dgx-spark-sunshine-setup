# /etc/default/tailscale-autoconnect
# Optional extra args for `tailscale up` (applied on every boot).
#
# After editing, reload and restart the service:
#   sudo systemctl daemon-reload
#   sudo systemctl restart tailscale-autoconnect
#
# Examples:
#   TS_UP_EXTRA_ARGS="--ssh"                           # Enable Tailscale SSH
#   TS_UP_EXTRA_ARGS="--advertise-exit-node"           # Act as exit node
#   TS_UP_EXTRA_ARGS="--ssh --accept-routes"           # Multiple flags
#
# Recommended default: leave empty.
TS_UP_EXTRA_ARGS=""
