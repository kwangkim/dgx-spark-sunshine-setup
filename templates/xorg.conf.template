# NVIDIA DGX Spark (GB10) X11 Configuration for Virtual Display
# Generated by DGX Spark Sunshine Setup Installer
# This configuration creates a virtual display using a custom EDID file

Section "ServerLayout"
    Identifier     "Layout0"
    Screen      0  "Screen0" 0 0
EndSection

Section "Screen"
    Identifier     "Screen0"
    Device         "NvidiaGB10"
    DefaultDepth    24
    SubSection "Display"
        Depth       24
        Modes      "3840x2160" "3440x1440" "2732x2048" "2560x1440" "1920x1080"
    EndSubSection
EndSection

Section "Device"
    Identifier     "NvidiaGB10"
    Driver         "nvidia"
    VendorName     "NVIDIA Corporation"
    BoardName      "GB10"
    BusID          "{{BUS_ID}}"
    # Use a generic digital flat panel target for the virtual headless display.
    # "TV-0" can leave the desktop blank on systems that only expose DFP outputs.
    Option         "ConnectedMonitor" "DFP"
    Option         "UseDisplayDevice" "DFP"
    Option         "CustomEDID" "DFP:{{EDID_PATH}}"
    Option         "IgnoreEDID" "false"
    Option         "UseEdidDpi" "false"
    Option         "AllowEmptyInitialConfiguration" "true"
EndSection
