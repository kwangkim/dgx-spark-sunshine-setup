# NVIDIA DGX Spark Sunshine Streaming Configuration
# Generated by DGX Spark Sunshine Setup Installer
# Optimized for GB10 hardware-accelerated encoding

# Allow external access
# WARNING: any remote host on the internet can access the Sunshine Web UI, not just your local network
# Ensure proper firewall and strong password
# origin_web_ui_allowed = wan

# Display Output
# Leave output_name unset so Sunshine can pick the active display automatically.
# Hardcoding HDMI-0 breaks on systems whose X11 output name or display id differs.

# Video Encoding Settings
encoder = nvenc
codec = {{CODEC}}
bitrate = {{BITRATE}}
fps = {{FPS}}

# Quality Settings
qp = 20
min_threads = 2

# NVENC-specific optimizations
nvenc_preset = p7
nvenc_tuning_info = lowlatency
nvenc_vbv_increase = 0
nvenc_rc = cbr

# Performance
channels = 2

# Custom Resolutions
# iPad Pro 12.9 M2 (2732x2048) and Dell AW3420DW (3440x1440)
resolutions = [
    3840x2160,
    3440x1440,
    2732x2048,
    2560x1440,
    1920x1080
]
